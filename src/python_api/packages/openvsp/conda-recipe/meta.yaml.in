package:
  name: openvsp
  version: @VSPVER_MAJOR@.@VSPVER_MINOR@.@VSPVER_PATCH@

source:
  path: ../

requirements:
  build:
    - python
    - setuptools

  # Kept in step with install_requires in setup.py.in.  degen_geom, utilities and
  # openvsp_config are built from this project alongside openvsp; numpy is wanted by the _vsp
  # extension itself, which calls import_array() as it loads.
  run:
    - python
    - numpy
    - degen_geom
    - utilities
    - openvsp_config
