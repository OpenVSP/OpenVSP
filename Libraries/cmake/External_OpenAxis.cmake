# The Rotatrix OpenAxis C++ SDK, for its 3D trackball, and what it needs: nlohmann_json and,
# off Windows, a crypto library.  LibreSSL's libcrypto stands in for OpenSSL's, so the build
# needs nothing from the system.  The SDK is Elastic-2.0 OR GPL-3.0-only; see LICENSE and
# LEGAL.md in its archive.  It verifies the device host it connects to, and OpenVSP uses the
# device only when that succeeds.  The SDK has no install rules, so OpenVSP links it from its
# build tree.

ExternalProject_Add( NLOHMANN_JSON
	URL ${CMAKE_CURRENT_SOURCE_DIR}/nlohmann_json-3.11.3.tar.xz
	URL_HASH SHA256=d6c65aca6b1ed68e7a182f4757257b107ae403032760ed6ef121c9d55e81757d
	DOWNLOAD_EXTRACT_TIMESTAMP TRUE
	CMAKE_ARGS -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
		-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
		-DCMAKE_INSTALL_PREFIX:PATH=<INSTALL_DIR>
		-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
		-DJSON_BuildTests=OFF
)
ExternalProject_Get_Property( NLOHMANN_JSON SOURCE_DIR INSTALL_DIR )
SET( NLOHMANN_JSON_SOURCE_DIR ${SOURCE_DIR} )
SET( NLOHMANN_JSON_INSTALL_DIR ${INSTALL_DIR} )

SET( OPENAXIS_DEPENDS NLOHMANN_JSON )
SET( OPENAXIS_CRYPTO_ARGS )
IF( NOT WIN32 )
	ExternalProject_Add( LIBRESSL
		URL ${CMAKE_CURRENT_SOURCE_DIR}/libressl-4.0.0.tar.gz
		URL_HASH SHA256=4d841955f0acc3dfc71d0e3dd35f283af461222350e26843fea9731c0246a1e4
		DOWNLOAD_EXTRACT_TIMESTAMP TRUE
		CMAKE_ARGS -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
			-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
			-DCMAKE_C_FLAGS=${CMAKE_C_FLAGS}
			-DCMAKE_INSTALL_PREFIX:PATH=<INSTALL_DIR>
			-DCMAKE_INSTALL_LIBDIR=lib
			-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
			-DCMAKE_POSITION_INDEPENDENT_CODE=ON
			-DBUILD_SHARED_LIBS=OFF
			-DLIBRESSL_APPS=OFF
			-DLIBRESSL_TESTS=OFF
	)
	ExternalProject_Get_Property( LIBRESSL SOURCE_DIR INSTALL_DIR )
	SET( LIBRESSL_SOURCE_DIR ${SOURCE_DIR} )
	SET( LIBRESSL_INSTALL_DIR ${INSTALL_DIR} )
	SET( LIBRESSL_CRYPTO_LIBRARY ${LIBRESSL_INSTALL_DIR}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}crypto${CMAKE_STATIC_LIBRARY_SUFFIX} )

	SET( OPENAXIS_DEPENDS ${OPENAXIS_DEPENDS} LIBRESSL )
	SET( OPENAXIS_CRYPTO_ARGS
		-DOPENSSL_ROOT_DIR=${LIBRESSL_INSTALL_DIR}
		-DOPENSSL_INCLUDE_DIR=${LIBRESSL_INSTALL_DIR}/include
		-DOPENSSL_CRYPTO_LIBRARY=${LIBRESSL_CRYPTO_LIBRARY}
		-DOPENSSL_USE_STATIC_LIBS=TRUE
		-DCMAKE_DISABLE_FIND_PACKAGE_PkgConfig=ON
	)
ENDIF()

ExternalProject_Add( OPENAXIS
	URL ${CMAKE_CURRENT_SOURCE_DIR}/openaxis-cpp-1.0.0-rc.1.tar.gz
	URL_HASH SHA256=d32c0fd68586b7f4f16aae7fc529295e6fd8f11337fab7b12524930cf6d2c7b9
	DOWNLOAD_EXTRACT_TIMESTAMP TRUE
	SOURCE_SUBDIR "cpp"
	DEPENDS ${OPENAXIS_DEPENDS}
	CMAKE_ARGS -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
		-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
		-DCMAKE_CXX_FLAGS=${CMAKE_CXX_FLAGS}
		-DCMAKE_C_FLAGS=${CMAKE_C_FLAGS}
		-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
		-DCMAKE_POSITION_INDEPENDENT_CODE=ON
		-DCMAKE_PREFIX_PATH=${NLOHMANN_JSON_INSTALL_DIR}
		-DOPENAXIS_BUILD_TESTS=OFF
		-DOPENAXIS_FETCH_DEPENDENCIES=OFF
		${OPENAXIS_CRYPTO_ARGS}
	INSTALL_COMMAND ""
)
ExternalProject_Get_Property( OPENAXIS SOURCE_DIR BINARY_DIR )
SET( OPENAXIS_SOURCE_DIR ${SOURCE_DIR} )
SET( OPENAXIS_BINARY_DIR ${BINARY_DIR} )
